{
  "root": "..",
  "notes_dirs": ["docs/notes"],
  "extra": [],
  "review": { "dir": "work/review", "since_days": 14, "stale_todo_weeks": 4, "archive_months": 6 },
  "retro": { "window_days": 14, "threshold": 0.08, "position_bins": "1-3,4-10,11-30,31-" },
  "schedule": {
    "jobs": [
      { "name": "review", "args": ["review"], "when": "weekly:mon:09:00" },
      { "name": "retro", "args": ["retro", "check"], "when": "weekly:mon:09:05" }
    ]
  }
}
